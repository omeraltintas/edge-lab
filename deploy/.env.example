# Kopyala ve sifreyi degistir:  cp .env.example .env
POSTGRES_USER=edge
POSTGRES_PASSWORD=degistir-beni
POSTGRES_DB=edge

# Docker host'ta yayinlanan portlar
APP_PORT=18000
DB_PORT=15432
DB_BIND=0.0.0.0

# short_url alaninda gorunecek adres (tarayicidan erisilen)
BASE_URL=http://192.168.56.10:18000

# Windows'tan calistirilan alembic icin (VM'de .env disinda tutulur):
# DATABASE_URL=postgresql+psycopg://edge:degistir-beni@192.168.56.10:15432/edge
