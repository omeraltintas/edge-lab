# Kopyala ve sifreyi degistir:  cp .env.example .env
POSTGRES_USER=edge
POSTGRES_PASSWORD=degistir-beni
POSTGRES_DB=edge

# Postgres (Windows'tan migration icin)
DB_PORT=15432
DB_BIND=0.0.0.0

# Kong: disariya acilan tek kapi + admin API
KONG_PROXY_PORT=18080
KONG_ADMIN_PORT=18081

# HAProxy: artik sadece ic agda. Bu port teshis icin: Kong'u atlayip
# dogrudan LB'ye gitmek istediginde kullanilir, yuk testinde kullanilmaz.
LB_DEBUG_PORT=18090
LB_STATS_PORT=18404

# Cache (Faz 3). Acmak/kapamak icin: make cache-on / make cache-off
# (shell degiskeni .env'i ezer, yani bu satiri elle degistirmek gerekmez)
CACHE_ENABLED=false
CACHE_TTL=300

# short_url alaninda gorunecek adres (Kong'un dis portu)
BASE_URL=http://192.168.56.10:18080

# Windows'tan calistirilan alembic icin (VM'de .env disinda tutulur):
# DATABASE_URL=postgresql+psycopg://edge:degistir-beni@192.168.56.10:15432/edge
